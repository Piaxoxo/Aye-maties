---
import { social } from '../data/social';
import { useT, type Lang } from '../i18n/ui';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useT(lang);
---
<section class="section social-section">
  <div class="wrap">
    <p class="eyebrow label-bracket" data-reveal>{t('ui.followVoyage')}</p>
    <div class="tiles">
      {social.map((s) => (
        <a class="tile" href={s.url} target="_blank" rel="noopener" data-reveal data-key={s.key}>
          <span class="tile-glow"></span>
          <span class="tile-top">
            <span class="tile-label mono">{s.label}</span>
            <span class="tile-arrow">↗</span>
          </span>
          <span class="tile-handle">{s.handle}</span>
          <span class="tile-blurb">{s.blurb}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .social-section{padding-top:clamp(70px,9vh,120px);}
  .tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px;margin-top:38px;}
  .tile{position:relative;overflow:hidden;display:flex;flex-direction:column;gap:10px;min-height:200px;padding:28px;
    border-radius:18px;border:1px solid var(--line);background:linear-gradient(155deg,rgba(12,79,110,.28),rgba(3,7,13,.6));
    transition:transform .6s var(--ease),border-color .5s;justify-content:space-between;}
  .tile:hover{transform:translateY(-8px);border-color:rgba(95,231,218,.5);}
  .tile-glow{position:absolute;width:220px;height:220px;border-radius:50%;right:-90px;bottom:-90px;pointer-events:none;
    background:radial-gradient(circle,rgba(34,199,192,.4),transparent 70%);opacity:0;transition:opacity .5s;}
  .tile:hover .tile-glow{opacity:1;}
  .tile[data-key="instagram"]:hover .tile-glow,.tile[data-key="instabts"]:hover .tile-glow{background:radial-gradient(circle,rgba(230,120,180,.4),transparent 70%);}
  .tile[data-key="youtube"]:hover .tile-glow{background:radial-gradient(circle,rgba(230,80,80,.4),transparent 70%);}
  .tile[data-key="facebook"]:hover .tile-glow{background:radial-gradient(circle,rgba(80,130,230,.4),transparent 70%);}
  .tile-top{display:flex;align-items:center;justify-content:space-between;}
  .tile-label{font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--aqua);}
  .tile-arrow{font-size:18px;color:var(--gold-soft);transition:transform .4s var(--ease);}
  .tile:hover .tile-arrow{transform:translate(4px,-4px);}
  .tile-handle{font-family:var(--display);text-transform:uppercase;font-size:clamp(22px,2.4vw,30px);line-height:1;}
  .tile-blurb{font-family:var(--serif);font-style:italic;color:var(--muted);font-size:15px;}
</style>
