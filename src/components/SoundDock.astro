---
import { useT, type Lang } from '../i18n/ui';
import { soundcloudUrl } from '../data/social';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useT(lang);
const scSrc = `https://w.soundcloud.com/player/?url=${encodeURIComponent(soundcloudUrl)}&color=%23e6c574&auto_play=false&hide_related=true&show_comments=false&show_user=true&show_reposts=false&show_teaser=false&visual=false`;
---
<div id="sound-dock" aria-live="polite">
  <div class="sound-ctrl">
    <button id="sound-mute" aria-label="Mute soundtrack">🔊</button>
    <input id="sound-vol" type="range" min="0" max="100" value="65" aria-label="Soundtrack volume" />
  </div>
  <button class="sound-btn" id="sound-btn" aria-label={t('ui.soundtrack')}>
    <span class="ico" aria-hidden="true">
      <span class="glow"></span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M2 12c2-3 4-3 6 0s4 3 6 0 4-3 6 0"/><path d="M2 17c2-3 4-3 6 0s4 3 6 0 4-3 6 0" opacity=".5"/></svg>
    </span>
    <span class="eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
    <span class="t-off">{t('ui.soundtrack')}</span>
    <span class="t-on">{t('ui.soundOn')}</span>
  </button>
</div>
<iframe id="sc-frame" title="Aye Maties soundtrack" allow="autoplay" loading="lazy" src={scSrc}></iframe>

<script>
  const dock = document.getElementById('sound-dock');
  const btn = document.getElementById('sound-btn');
  const frame = document.getElementById('sc-frame');
  const muteBtn = document.getElementById('sound-mute');
  const vol = document.getElementById('sound-vol');
  const get = (k, d) => { try { return localStorage.getItem('aym_' + k) ?? d; } catch { return d; } };
  const set = (k, v) => { try { localStorage.setItem('aym_' + k, v); } catch {} };

  let widget = null, ready = false, playing = false, _vol = 0;
  let muted = get('mute', '0') === '1';
  let target = parseInt(get('vol', '65'), 10); if (isNaN(target)) target = 65;
  vol.value = String(target);

  function loadAPI() {
    return new Promise((res) => {
      if (window.SC?.Widget) return res();
      const s = document.createElement('script');
      s.src = 'https://w.soundcloud.com/player/api.js'; s.onload = res; s.onerror = res;
      document.head.appendChild(s);
    });
  }
  async function ensure() {
    if (widget) return widget;
    await loadAPI();
    if (!window.SC?.Widget) return null;
    widget = SC.Widget(frame);
    widget.bind(SC.Widget.Events.READY, () => { ready = true; widget.setVolume(0); });
    widget.bind(SC.Widget.Events.PLAY, () => { playing = true; paint(); });
    widget.bind(SC.Widget.Events.PAUSE, () => { playing = false; paint(); });
    widget.bind(SC.Widget.Events.FINISH, () => { widget.seekTo(0); widget.play(); });
    return widget;
  }
  function fade(to, ms = 1600) {
    const from = _vol, start = performance.now();
    (function step(now) { const p = Math.min(1, (now - start) / ms); _vol = from + (to - from) * p; widget?.setVolume(_vol); if (p < 1) requestAnimationFrame(step); })(start);
  }
  function paint() {
    btn.classList.toggle('on', playing && !muted);
    dock.classList.toggle('expanded', get('activated', '0') === '1');
    muteBtn.textContent = muted ? '🔇' : '🔊';
  }
  async function activate() {
    set('activated', '1'); set('sound', 'on');
    await ensure();
    if (!widget) { dock.classList.add('expanded'); return; }
    if (!ready) await new Promise((r) => widget.bind(SC.Widget.Events.READY, r));
    widget.play(); fade(muted ? 0 : target, 2000); dock.classList.add('expanded'); paint();
  }
  btn.addEventListener('click', () => {
    if (get('activated', '0') !== '1') return activate();
    if (!widget) return;
    if (playing) widget.pause(); else { widget.play(); fade(muted ? 0 : target, 700); }
  });
  muteBtn.addEventListener('click', () => { muted = !muted; set('mute', muted ? '1' : '0'); fade(muted ? 0 : target, 400); paint(); });
  vol.addEventListener('input', () => { target = parseInt(vol.value, 10); set('vol', String(target)); if (!muted) { _vol = target; widget?.setVolume(target); } });

  // expose so the enter-gate can start audio on first interaction
  window.aymActivateSound = activate;
  if (get('sound', 'off') === 'on') { dock.classList.add('expanded'); addEventListener('pointerdown', () => activate(), { once: true }); }
  paint();
</script>

<style>
  #sound-dock{position:fixed;z-index:700;bottom:clamp(16px,3vh,26px);right:var(--pad);display:flex;align-items:center;gap:0;}
  #sound-dock.expanded{gap:12px;}
  .sound-btn{position:relative;display:flex;align-items:center;gap:12px;padding:13px 22px 13px 15px;border-radius:60px;cursor:pointer;
    font-family:var(--mono);font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--ink);
    background:linear-gradient(150deg,rgba(12,79,110,.5),rgba(3,7,13,.62));border:1px solid rgba(95,231,218,.4);
    backdrop-filter:blur(12px);box-shadow:0 10px 40px rgba(0,0,0,.5);transition:border-color .5s,transform .4s var(--ease),box-shadow .5s;}
  .sound-btn:hover{border-color:var(--gold);transform:translateY(-2px);box-shadow:0 12px 50px rgba(34,199,192,.35);}
  .sound-btn.on{border-color:rgba(230,197,116,.7);}
  .ico{position:relative;width:28px;height:28px;flex:0 0 auto;color:var(--aqua);}
  .ico .glow{position:absolute;inset:-6px;border-radius:50%;background:radial-gradient(circle,rgba(34,199,192,.5),transparent 70%);opacity:0;animation:pulse 3s var(--ease) infinite;}
  .sound-btn.on .ico .glow{opacity:1;}
  @keyframes pulse{0%,100%{transform:scale(.85);opacity:.3;}50%{transform:scale(1.15);opacity:.7;}}
  .eq{display:none;align-items:flex-end;gap:3px;height:15px;}
  .sound-btn.on .eq{display:flex;}
  .sound-btn.on .t-off,.sound-btn .t-on{display:none;}
  .sound-btn.on .t-on{display:inline;}
  .eq i{width:3px;background:var(--aqua);border-radius:2px;animation:eq 1s ease-in-out infinite;}
  .eq i:nth-child(2){animation-delay:.2s;}.eq i:nth-child(3){animation-delay:.4s;}.eq i:nth-child(4){animation-delay:.1s;}
  @keyframes eq{0%,100%{height:4px;}50%{height:15px;}}
  .sound-ctrl{display:flex;align-items:center;gap:10px;padding:11px 16px;border-radius:60px;max-width:0;overflow:hidden;opacity:0;
    background:linear-gradient(150deg,rgba(12,79,110,.5),rgba(3,7,13,.62));border:1px solid rgba(95,231,218,.3);backdrop-filter:blur(12px);
    transition:max-width .55s var(--ease),opacity .4s,padding .4s;}
  #sound-dock.expanded .sound-ctrl{max-width:220px;opacity:1;}
  .sound-ctrl button{background:none;border:none;color:var(--muted);cursor:pointer;font-size:14px;transition:color .3s;}
  .sound-ctrl button:hover{color:var(--aqua);}
  .sound-ctrl input{-webkit-appearance:none;appearance:none;width:84px;height:3px;border-radius:3px;background:rgba(255,255,255,.2);}
  .sound-ctrl input::-webkit-slider-thumb{-webkit-appearance:none;width:13px;height:13px;border-radius:50%;background:var(--turq);box-shadow:0 0 8px var(--turq);cursor:pointer;}
  .sound-ctrl input::-moz-range-thumb{width:13px;height:13px;border:none;border-radius:50%;background:var(--turq);cursor:pointer;}
  #sc-frame{position:fixed;width:1px;height:1px;opacity:0;pointer-events:none;bottom:0;left:0;border:0;}
  @media(max-width:560px){#sound-dock{right:50%;transform:translateX(50%);}#sound-dock.expanded{flex-direction:column-reverse;align-items:center;}}
</style>
