---
import { useT, asset, type Lang } from '../i18n/ui';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useT(lang);
---
<div id="enter" role="dialog" aria-label={t('ui.enter')}>
  <div class="enter-inner">
    <img class="enter-logo" src={asset('/logo.png')} alt="Aye Maties" width="220" height="220" />
    <p class="enter-tag">{t('ui.enterTag')}</p>
    <button class="enter-btn" id="enter-btn" data-magnetic>{t('ui.enter')}</button>
    <button class="enter-muted" id="enter-muted">{t('ui.enterMuted')}</button>
    <div class="enter-bar"><i></i></div>
  </div>
</div>

<script>
  const enter = document.getElementById('enter');
  if (enter) {
    document.body.style.overflow = 'hidden';
    const go = (withSound) => {
      enter.classList.add('gone');
      document.body.style.overflow = '';
      window.dispatchEvent(new Event('aym:enter'));
      if (withSound && window.aymActivateSound) window.aymActivateSound();
      setTimeout(() => enter.remove(), 1200);
    };
    document.getElementById('enter-btn')?.addEventListener('click', () => go(true));
    document.getElementById('enter-muted')?.addEventListener('click', () => go(false));
  }
</script>

<style>
  #enter{position:fixed;inset:0;z-index:10000;display:flex;align-items:center;justify-content:center;text-align:center;
    background:radial-gradient(80% 80% at 50% 35%, #0a3b54 0%, var(--abyss) 70%);
    transition:opacity 1.1s var(--ease),visibility 1.1s;}
  #enter.gone{opacity:0;visibility:hidden;}
  .enter-inner{display:flex;flex-direction:column;align-items:center;gap:24px;padding:24px;}
  .enter-logo{width:clamp(150px,26vw,240px);height:auto;filter:drop-shadow(0 20px 70px rgba(0,0,0,.7));animation:float 5s var(--ease) infinite;}
  @keyframes float{0%,100%{transform:translateY(0);}50%{transform:translateY(-12px);}}
  .enter-tag{font-family:var(--serif);font-style:italic;color:var(--aqua);font-size:clamp(15px,2vw,20px);}
  .enter-btn{margin-top:6px;padding:19px 52px;border-radius:60px;cursor:pointer;font-family:var(--mono);
    font-size:13px;letter-spacing:.3em;text-transform:uppercase;color:var(--ink);background:rgba(255,255,255,.04);
    border:1px solid rgba(95,231,218,.45);overflow:hidden;position:relative;isolation:isolate;
    transition:color .5s,border-color .5s,transform .3s var(--ease);}
  .enter-btn::before{content:'';position:absolute;inset:0;z-index:-1;border-radius:60px;
    background:linear-gradient(120deg,var(--teal),var(--turq));transform:translateY(101%);transition:transform .55s var(--ease);}
  .enter-btn:hover{color:var(--abyss);border-color:transparent;}
  .enter-btn:hover::before{transform:translateY(0);}
  .enter-muted{background:none;border:none;color:var(--muted-2);font-family:var(--mono);font-size:11px;
    letter-spacing:.18em;text-transform:uppercase;cursor:pointer;transition:color .3s;}
  .enter-muted:hover{color:var(--aqua);}
  .enter-bar{width:200px;height:1px;background:rgba(255,255,255,.12);overflow:hidden;position:relative;}
  .enter-bar i{position:absolute;inset:0;background:var(--turq);transform-origin:left;transform:scaleX(0);animation:load 2.2s var(--ease) forwards;}
  @keyframes load{to{transform:scaleX(1);}}
</style>
