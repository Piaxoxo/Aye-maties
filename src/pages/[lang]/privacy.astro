---
import Privacy from '../../components/pages/Privacy.astro';
import { locales, defaultLang, type Lang } from '../../i18n/ui';
export function getStaticPaths() {
  return locales.filter((l) => l !== defaultLang).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
---
<Privacy lang={lang} />
